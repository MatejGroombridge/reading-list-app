    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left page -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,40.5 C45,36.5 38,35 31,35.5 L31,70 C38,69.5 45,71 51,75 Z" />

    <!-- Right page -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57,40.5 C63,36.5 70,35 77,35.5 L77,70 C70,69.5 63,71 57,75 Z" />
</vector>
