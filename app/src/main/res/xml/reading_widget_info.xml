<?xml version="1.0" encoding="utf-8"?>
<!--
    AppWidget metadata for the current-reads widget. Defaults to 3x2 cells
    (room for the header and three books); resizable either way, and Glance
    re-renders to fill whatever space the launcher gives it. No configure
    activity — it always shows what's being read.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/glance_default_loading_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
